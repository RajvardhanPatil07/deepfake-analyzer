# Copy this file to .env and set your Google Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated fallback models for temporary Gemini overload/rate-limit errors.
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Optional: local Hugging Face classifier signal for fake/real probability.
# Install requirements-detector.txt before enabling this locally.
HF_DETECTOR_ENABLED=false
HF_DETECTOR_MODEL=xRayon/convnext-ai-images-detector
HF_DETECTOR_VIDEO_FRAMES=8
HF_DETECTOR_FAKE_THRESHOLD=0.55
